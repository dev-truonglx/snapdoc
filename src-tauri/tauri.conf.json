{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnapDoc",
  "version": "0.1.1",
  "identifier": "com.snapdoc.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": ["png", "jpg", "jpeg", "webp", "bmp", "gif"],
        "name": "Image",
        "description": "Image file",
        "role": "Editor",
        "mimeType": "image/*"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwQjMwRTc0RDEyOTc3NDkKUldSSmR5blJkQTZ6d0h1TjVyT0JhaDk4Qkx3UW1vN1NDQTEwWUdWbjhMazJIV002azdGMTRxZEYK",
      "endpoints": [
        "https://github.com/dev-truonglx/snapdoc/releases/latest/download/latest.json"
      ]
    }
  }
}
