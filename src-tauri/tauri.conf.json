{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnapDoc",
  "version": "1.2.3",
  "identifier": "com.snapdoc.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "node scripts/fetch-ffmpeg.mjs && npm run dev",
    "beforeBuildCommand": "node scripts/fetch-ffmpeg.mjs && npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/SnapDoc/library/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": [
          "png",
          "jpg",
          "jpeg",
          "webp",
          "bmp",
          "gif"
        ],
        "name": "SnapDoc.ImageFile",
        "description": "Open with SnapDoc Editor",
        "role": "Editor",
        "mimeType": "image/*"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwQjMwRTc0RDEyOTc3NDkKUldSSmR5blJkQTZ6d0h1TjVyT0JhaDk4Qkx3UW1vN1NDQTEwWUdWbjhMazJIV002azdGMTRxZEYK",
      "endpoints": [
        "https://github.com/dev-truonglx/snapdoc/releases/latest/download/latest.json"
      ]
    }
  }
}
