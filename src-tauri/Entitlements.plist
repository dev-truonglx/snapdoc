<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required under Hardened Runtime (flags=0x10000) so macOS TCC allows
	     microphone audio capture (kTCCServiceMicrophone) when recording video. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Required under Hardened Runtime when interacting with AppleEvents. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
